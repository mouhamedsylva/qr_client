# Adresse de l'API QR-Order (le port 5173 doit figurer dans CORS_ORIGINS côté API)
NUXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
# Serveur temps réel (Socket.IO, namespace /realtime)
NUXT_PUBLIC_SOCKET_URL=http://localhost:3000
# Clé PUBLIQUE Stripe (pk_test_… / pk_live_…) pour le paiement par carte.
# Sans clé, la carte est proposée comme indisponible.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
